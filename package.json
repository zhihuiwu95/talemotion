{
  "name": "talemotion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "scene:validate": "tsx scripts/validate-scenes.mjs",
    "stories:validate": "tsx scripts/validate-stories.ts",
    "stories:export": "tsx scripts/validate-stories.ts --export",
    "stories:review": "tsx scripts/validate-stories.ts --review",
    "quality": "npm run scene:validate && npm run stories:validate && npm run audio:verify && npm test && npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "audio:collect": "tsx scripts/collect-narration.ts",
    "audio:generate": "npm run audio:collect && .venv/bin/python scripts/generate-audio.py",
    "audio:verify": "npm run audio:collect && node scripts/verify-audio.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
