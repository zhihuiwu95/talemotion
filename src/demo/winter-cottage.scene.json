      "duration": 4,
      "ease": "sine.inOut"
    },
    {
      "at": 106,
      "type": "move",
      "target": "rabbit",
      "to": { "x": 760, "y": 638 },
      "duration": 7,
      "ease": "power1.inOut"
    },
    {
      "at": 106,
      "type": "scale",
